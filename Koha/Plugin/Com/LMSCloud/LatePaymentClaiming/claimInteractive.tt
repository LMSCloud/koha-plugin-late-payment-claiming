[% USE raw %]
[% USE Asset %]
[% USE KohaDates %]
[% USE AuthorisedValues %]
[% USE Categories %]
[% USE Branches %]
[% USE JSON.Escape %]
[% USE Koha %]
[% USE Price %]
[% SET footerjs = 1 %]

[% PROCESS 'patron-search.inc' %]

[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Gebührenmahnung Plugin: Interaktives Mahnen</title>
[% INCLUDE 'doc-head-close.inc' %]
<link rel="stylesheet" type="text/css" href="/api/v1/contrib/latepaymentclaiming/static/css/latepaymentclaiming.css" />
</head>
<body id="latePaymentClaimsTool">
[% INCLUDE 'html_helpers.inc' %]

[% WRAPPER 'header.inc' %]
    [% INCLUDE 'patron-search-header.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/tools/tools-home.pl">Werkzeuge</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3ACom%3A%3ALMSCloud%3A%3ALatePaymentClaiming&method=tool">Werkzeuge für Gebührenmahnvorgänge</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Interaktives Mahnen</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]


<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <main>
                <h1>Gebührenmahnung: Interaktives Mahnen</h1>
                [% IF error %]
                    [% IF error == "limitError" %]
                        <div class="alert alert-danger">
                            Es wurden mehr als <strong>[% countClaimsLimit | html %]</strong> Gebührenmahnungen zur Durchführung ausgewählt.
                        </div>
                    [% ELSIF error == "noSelection" %]
                        <div class="alert alert-danger">
                            Es wurde keine anstehende Gebührenmahnung ausgewählt.
                        </div>
                    [% ELSIF error == "executionError" %]
                        <div class="alert alert-danger">
                            Fehler bei der Ausführung der Gebührenmahnung: <br/>
                            [% errorText | html %]
                        </div>
                    [% ELSE %]
                        <div class="alert alert-danger">
                            Fehler bei der Ausführung der Gebührenmahnung: <br/>
                            [% error | html %][% IF errorText %]: [% errorText | html %][% END %]
                        </div>
                    [% END %]
                [% END %]
                [% IF patronsToClaim && patronsToClaim.size > 0 %]
                    <p>
                        Mit dieser Funktion können Sie anstehende Gebührenmahnungen prüfen und gegebenenfalls durchführen.
                        Nachfolgende Tabelle listet alle anstehenden Gebührenmahnfälle der Selektion für die neue Mahnstufe und den durchzuführenden Aktionen auf.
                        Wählen Sie die Gebührenmahnungen aus, die durchgeführt werden sollen.
                    </p>
                    <p>
                        Es können maximal <strong>[% countClaimsLimit | html %]</strong> Gebührenmahnungen interaktiv durchgeführt werden.
                        [% IF patronsToClaim.size > countClaimsLimit %]
                        <br/>
                        Es stehen <strong>[% patronsToClaim.size | html %]</strong> Gebührenmahnungen an. Die übrigen bleiben anstehend. Sie können nach dem Durchführen erneut interaktiv durchgeführt oder im Tageslauf gemahnt werden.
                        [% END %]
                    </p>
                    <form method="post" id="start_claiming_action">
                        <input type="hidden" name="class" value="[% CLASS %]"/>
                        <input type="hidden" name="method" value="[% METHOD %]"/>
                        [%# Koha's CSRF middleware rejects any POST without a token; the include is missing before 24.05 %]
                        [% TRY %][% PROCESS 'csrf-token.inc' %][% CATCH %][% END %]
                        <input type="hidden" name="do" value="start"/>
                        <input type="hidden" name="toolaction" value="claimInteractive"/>
                        <input type="hidden" name="patron_ids" id="claim_patron_ids" value=""/>
                        
                        <input type="submit" id="start_claiming_button" value="Ausgewählte Gebührenmahnungen durchführen"/>
                        <a class="btn btn-default btn-xs" id="claim_select_all" href="javascript:void(0)">Alle auswählen</a>
                        <a class="btn btn-default btn-xs" id="claim_select_none" href="javascript:void(0)">Auswahl aufheben</a>
                        <span id="claim_selection_info"></span>
                    </form>
                    <div class="alert alert-info" id="claim_selection_hint" style="display:none; margin-top:10px"></div>
                    
                    <table id="patronsToClaim" class="table table-striped dt-responsive">
                        <thead>
                            <tr>
                                <th>Auswahl</th>
                                <th>Mahn&shy;stufe</th>
                                <th>Benutzer</th>
                                <th>Ausweisnummer</th>
                                <th>Bibliothek</th>
                                <th>Kate&shy;gorie</th>
                                <th>Gebüh&shy;ren&shy;stand</th>
                                <th>Selektion</th>
                                <th>Aktion(en)</th>
                            </tr>
                        </thead>
                        <tbody>
                            [% FOREACH patronToClaim IN patronsToClaim %]
                            <tr data-patron-id="[% patronToClaim.patron.borrowernumber | html %]">
                                [% patron = patronToClaim.patron %]
                                <td class="latepaypemnt_claim_list_centercol">
                                    <input type="checkbox" class="claim_select" value="[% patron.borrowernumber | html %]" aria-label="Gebührenmahnung auswählen"/>
                                </td>
                                <td class="latepaypemnt_claim_list_centercol">
                                    [% patronToClaim.level | html %]
                                </td>
                                <td>
                                    <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% patron.borrowernumber | html %]" title="Bearbeiten" class="patron_name">[% patron.surname | html %][% IF patron.firstname %], [% patron.firstname | html %][% END %]</a>
                                </td>
                                <td>
                                    <a href="/cgi-bin/koha/circ/circulation.pl?borrowernumber=[% patron.borrowernumber | html %]" title="Ausleihen" class="patron_name" style="white-space:pre-wrap;word-break:break-all;hyphens:auto;overflow-wrap:break-word;">[% patron.cardnumber | html %]</a>
                                </td>
                                <td>
                                    [% Branches.GetName(patronToClaim.library_id) | html %]
                                </td>
                                <td>
                                    [% Categories.GetName(patronToClaim.category_id) | html %]
                                </td>
                                <td class="latepaypemnt_claim_list_rightcol">
                                    <span class='debit'>
                                        <strong>
                                        [% patron.account.balance | $Price %]
                                        </strong>
                                    </span>
                                </td>
                                <td>
                                    <div class="show_patron_selection_details">
                                        <a class="btn btn-default btn-xs"><i class="fa fa-eye"></i> Anzeigen</a>
                                        <div class="latepayment_userselection_list" style="display:none">
                                            <ul>
                                                [% FOREACH selection IN patronToClaim.patron_selection %]
                                                <li>
                                                    [% selection.description | html %]
                                                </li>
                                                [% END %]
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="show_ban_action_details">
                                        <a class="btn btn-default btn-xs"><i class="fa fa-eye"></i> Anzeigen</a>
                                        <div  class="latepayment_banaction_list" style="display:none">
                                            <ul>
                                                [% FOREACH action IN patronToClaim.ban_actions %]
                                                <li>
                                                    [% action.description | html %]
                                                </li>
                                                [% END %]
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            [% END %]
                        </tbody>
                    </table>
                [% ELSE %]
                <div class="alert alert-warning">
                    Es wurden anhand der aktuellen Gebührenmahnkonfiguration keine im Moment durchzuführenden Gebührenmahnungen gefunden.
                </div>
                [% END %]
            </main>
        </div>
    </div>
</div>

<!-- Show selection details -->
<div class="modal" id="show_selections" tabindex="-1" role="dialog" aria-labelledby="show_selections_details_title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closebtn" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="show_selections_details_title">Selektionen</h4>
            </div>
            <div class="modal-body">
                <legend id="show_selection_details_legend">Selektionen für die Gebührenmahnung:</legend>
                <div id="showSelectionsDetail">
                
                </div>
            </div> <!-- /.modal-body -->
            <div class="modal-footer">
                <form id="show_selections_actions">
                    <button type="button" class="btn btn-default deny" data-dismiss="modal" data-bs-dismiss="modal">Abbrechen</button>
                </form>
            </div> <!-- /.modal-footer -->
        </div> <!-- /.modal-content -->
    </div> <!-- /.modal-dialog -->
</div> <!-- /.modal -->

<!-- Show ban action details -->
<div class="modal" id="show_banactions" tabindex="-1" role="dialog" aria-labelledby="show_banactions_details_title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closebtn" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="show_banactions_details_title">Aktionen</h4>
            </div>
            <div class="modal-body">
                <legend id="show_banactions_details_legend">Aktionen für die Gebührenmahnung:</legend>
                <div id="showBanactionsDetail">
                
                </div>
            </div> <!-- /.modal-body -->
            <div class="modal-footer">
                <form id="show_selections_actions">
                    <button type="button" class="btn btn-default deny" data-dismiss="modal" data-bs-dismiss="modal">Abbrechen</button>
                </form>
            </div> <!-- /.modal-footer -->
        </div> <!-- /.modal-content -->
    </div> <!-- /.modal-dialog -->
</div> <!-- /.modal -->

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'calendar.inc' %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'select2.inc' %]
    <script>
        $(document).ready(function() {
            var claimLimit = [% countClaimsLimit | html %];
            var selectedClaims = {};
            
            function selectedClaimCount() {
                return Object.keys(selectedClaims).length;
            }
            
            function updateClaimSelection() {
                var count = selectedClaimCount();
                $('#patronsToClaim .claim_select').each(function() {
                    $(this).prop('checked', !!selectedClaims[this.value]);
                });
                $('#claim_selection_info').text('Ausgewählt: ' + count + ' von maximal ' + claimLimit);
                $('#start_claiming_button').prop('disabled', count == 0);
            }
            
            // preselect the first claims of the list, at most the number that can be claimed at once
            $('#patronsToClaim tbody tr').each(function(index) {
                if ( index < claimLimit ) {
                    selectedClaims[$(this).attr('data-patron-id')] = true;
                }
            });
            
            var claimList = $("#patronsToClaim").dataTable($.extend(true, {}, dataTablesDefaults, {
                    'serverSide': false,
                    'deferRender': true,
                    'paging': true,
                    'pageLength': 20,
                    'lengthMenu': [10, 20, 50, 100, 500, 1000],
                    'pagingType': 'full_numbers',
                    'processing': true,
                    "buttons": [{
                        fade: 100,
                        className: "dt_button_clear_filter",
                        titleAttr: __('Suche leeren'),
                        enabled: false,
                        text: '<i class="fa fa-lg fa-remove"></i> <span class="dt-button-text">' + __('Suche leeren') + '</span>',
                        action: function ( e, dt, node ) {
                            dt.search( "" ).draw("page");
                            node.addClass("disabled");
                        }
                    }],
                    "columnDefs": [ { "targets": 0, "orderable": false, "searchable": false } ],
                    "order": [[ 1, "asc" ],[ 2, "asc" ]],
                    "oLanguage": {
                        "sSearch":         "Suchen: ",
                        "sEmptyTable":     "Keine anstehenden Gebührenmahnungen gefunden",
                        "sInfo":           "Zeige _START_ bis _END_ von _TOTAL_ anstehenden Gebührenmahnungen",
                        "sInfoEmpty":      "Zeige 0 bis 0 von 0 anstehende Gebührenmahnungen",
                        "sInfoFiltered":   "(gefiltert von _MAX_ anstehenden Gebührenmahnungen gesamt)",
                        "sLengthMenu":     "Zeige _MENU_ anstehende Gebührenmahnungen",
                        "oPaginate": {
                            "sFirst":      "Erste",
                            "sLast":       "Letzte",
                            "sNext":       "Nächste",
                            "sPrevious":   "Vorige"
                        },
                    },
                    drawCallback: function (settings) {
                        updateClaimSelection();
                        $('.show_patron_selection_details a').click(function() {
                            $('#showSelectionsDetail').html('<ul>'+$(this).parent().find('ul').html()+'</ul>');
                            var modal = $("#show_selections");
                            modal.modal("show");
                        });
                        $('.show_ban_action_details a').click(function() {
                            $('#showBanactionsDetail').html('<ul>'+$(this).parent().find('ul').html()+'</ul>');
                            var modal = $("#show_banactions");
                            modal.modal("show");
                        } );
                    }
                }));
            
            $('#patronsToClaim').on('change', '.claim_select', function() {
                if ( this.checked ) {
                    if ( selectedClaimCount() >= claimLimit ) {
                        this.checked = false;
                        $('#claim_selection_hint').text('Es können maximal ' + claimLimit + ' Gebührenmahnungen auf einmal ausgewählt werden.').show();
                        return;
                    }
                    selectedClaims[this.value] = true;
                } else {
                    delete selectedClaims[this.value];
                }
                $('#claim_selection_hint').hide();
                updateClaimSelection();
            });
            
            // select the claims in the order and with the filter currently shown, until the limit is reached
            $('#claim_select_all').on('click', function() {
                var truncated = false;
                claimList.api().rows({ search: 'applied', order: 'applied' }).every(function() {
                    var patronId = $(this.node()).attr('data-patron-id');
                    if ( selectedClaims[patronId] ) return;
                    if ( selectedClaimCount() >= claimLimit ) {
                        truncated = true;
                        return;
                    }
                    selectedClaims[patronId] = true;
                });
                if ( truncated ) {
                    $('#claim_selection_hint').text('Es wurden die ersten ' + claimLimit + ' Gebührenmahnungen der angezeigten Reihenfolge ausgewählt. Mehr können nicht auf einmal durchgeführt werden.').show();
                } else {
                    $('#claim_selection_hint').hide();
                }
                updateClaimSelection();
            });
            
            $('#claim_select_none').on('click', function() {
                selectedClaims = {};
                $('#claim_selection_hint').hide();
                updateClaimSelection();
            });
            
            $('#start_claiming_action').on('submit', function(event) {
                if ( selectedClaimCount() == 0 ) {
                    event.preventDefault();
                    return;
                }
                $('#claim_patron_ids').val(Object.keys(selectedClaims).join(','));
            });
            
            updateClaimSelection();
        });
    </script>
[% END %]
[% INCLUDE 'intranet-bottom.inc' %]
